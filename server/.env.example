# 复制为 server/.env。此文件不要提交。

# DeepSeek 或任何 OpenAI 兼容接口的密钥。不填则只能检索，不能生成回答。
DEEPSEEK_API_KEY=

# 视觉模型密钥。不填时，若 config.yaml 配了 vision.baseUrl，则改用上面的密钥。
VISION_API_KEY=

HOST=127.0.0.1
PORT=3000

# 本机的 gbrain 不在 PATH 里时，写可执行文件的绝对路径。不要写进 config.yaml。
# GBRAIN_BIN=/home/你的用户名/.local/bin/gbrain

# 项目独立知识库分区的工作目录。不填则用 ~/kb-sources/<项目id>
# KB_SOURCES_DIR=/home/你的用户名/kb-sources

# 查询向量超时（毫秒）。GBrain 默认 6 秒，超时会静默改走关键词。硅基流动建议 20000。
GBRAIN_QUERY_EMBED_TIMEOUT_MS=20000

# 语义检索用的 embedding（与手工 CLI 同一套）。不填则 search 只有关键词。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 飞书自建应用。不填则 /api/feishu/events 返回未配置。
# 固定域名：Cloudflare Tunnel 指到 127.0.0.1:3000，开放平台填 https://kb.你的域名.com/api/feishu/events
# 临时测：npm run tunnel，用日志里的 trycloudflare 地址（每次会变）。
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=

# 小A（Hermes 网关）：管理端「找小A」用；key 取 ~/.hermes/profiles/agv/.env 的 API_SERVER_KEY
HERMES_API_URL=http://127.0.0.1:8377
HERMES_MODEL=agv
HERMES_API_KEY=

# 外部 agent 只用网页「绑定外部 agent」下载的个人钥匙（kb_…）。不要再写 AGENT_TOKENS。
