# 复制为 server/.env。此文件不要提交。

# DeepSeek 或任何 OpenAI 兼容接口的密钥。不填则只能检索，不能生成回答。
DEEPSEEK_API_KEY=

# 视觉模型密钥。不填时，若 config.yaml 配了 vision.baseUrl，则改用上面的密钥。
VISION_API_KEY=

HOST=127.0.0.1
PORT=3000

# 本机的 gbrain 不在 PATH 里时，写可执行文件的绝对路径。不要写进 config.yaml。
# GBRAIN_BIN=/home/你的用户名/.local/bin/gbrain

# 项目独立知识库分区的工作目录。不填则用 ~/kb-sources/<项目id>
# KB_SOURCES_DIR=/home/你的用户名/kb-sources

# 查询向量超时（毫秒）。GBrain 默认 6 秒，超时会静默改走关键词（高频词如「AGV」会抢排序）。
# 硅基流动建议 ≥ 20000。
GBRAIN_QUERY_EMBED_TIMEOUT_MS=20000

# ---------- 语义检索 embedding（强烈建议配）----------
# kb-web 首轮把「去口语后的整句」交给 gbrain search，设计依赖 bge-m3。
# 不配下面两项 → 只有关键词匹配：领域高频词（AGV/机器人）会淹没真正答案页。
#
# 推荐硅基流动（与部署机一致）：
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
#
# 注意：
# - 这是给 GBrain CLI 读的环境变量名（OpenAI 兼容），不是 DeepSeek 对话密钥。
# - 不要设 provider_base_urls.openai（会拼成 .../v1/v1/embeddings → 404）。
# - 模型用 BAAI/bge-m3（1024 维）；换模型要整库重 embed。
#
# 配好后必须给库建向量（否则 stats.embedded_count 仍是 0，检索仍像关键词）：
#   export OPENAI_API_KEY=... OPENAI_BASE_URL=https://api.siliconflow.cn/v1
#   gbrain embed --stale --yes
# 自检：
#   gbrain stats --json          # embedded_count 应接近 page_count
#   gbrain search "自研AGV 轮子数量" --json --source-id __all__
# 日志出现 degraded=embed_timeout → 加大 GBRAIN_QUERY_EMBED_TIMEOUT_MS 或查 key/网络。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 飞书自建应用。不填则 /api/feishu/events 返回未配置。
# 固定域名：Cloudflare Tunnel 指到 127.0.0.1:3000，开放平台填 https://kb.你的域名.com/api/feishu/events
# 临时测：npm run tunnel，用日志里的 trycloudflare 地址（每次会变）。
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=

# 小A（Hermes 网关）：管理端「找小A」用；key 取 ~/.hermes/profiles/agv/.env 的 API_SERVER_KEY
HERMES_API_URL=http://127.0.0.1:8377
HERMES_MODEL=agv
HERMES_API_KEY=

# 外部 agent 只用网页「绑定外部 agent」下载的个人钥匙（kb_…）。不要再写 AGENT_TOKENS。
